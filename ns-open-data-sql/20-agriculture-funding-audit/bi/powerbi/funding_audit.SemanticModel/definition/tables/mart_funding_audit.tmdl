	partition mart_funding_audit = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("bi\exports\mart_funding_audit.csv"), [Delimiter = ",", Columns = 8, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers",{{"fiscal_year", type text}, {"fiscal_year_start", Int64.Type}, {"division", type text}, {"program_name", type text}, {"recipient", type text}, {"payment_amount", Currency.Type}, {"is_duplicate_candidate", Int64.Type}, {"dup_occurrences", Int64.Type}})
				in
				  #"Changed column type"

	annotation PBI_NavigationStepName = Navigation

