table mart_funding_audit
	lineageTag: 29d600e6-9255-4b88-bd50-679584eda93b

	measure 'Total Dollars' = SUM ( mart_funding_audit[payment_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 236dd425-563b-4843-9e6c-0cc6992bec3b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Base Dollars' =
			
			CALCULATE ( [Total Dollars], ALL ( mart_funding_audit[recipient] ) )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1dd60e75-605f-4be4-884c-7bcd0b568336

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cumulative Dollars' =
			
			VAR CurrentDollars = [Total Dollars]
			RETURN
			    CALCULATE (
			        [Total Dollars],
			        FILTER (
			            ALL ( mart_funding_audit[recipient] ),
			            [Total Dollars] >= CurrentDollars
			        )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 19e5ab2c-18a6-4734-ad8a-01d946e53adb

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Cumulative Share %' =
			
			DIVIDE ( [Cumulative Dollars], [Base Dollars] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 95e85af3-3dc1-4a83-b0c4-2b44c9493b44

	measure 'Top 10 Dollars' =
			
			CALCULATE (
			    [Total Dollars],
			    TOPN (
			        10,
			        ALL ( mart_funding_audit[recipient] ),
			        [Total Dollars],
			        DESC
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: bb2aff9d-1987-4526-a3a0-37b9dc42c620

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Top 10 Concentration %' =
			
			DIVIDE ( [Top 10 Dollars], [Base Dollars] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ff95c096-9fd9-4fe4-8cf4-546974f31a0d

	measure 'Dollars Previous Year' =
			
			VAR CurrentYear = MAX ( mart_funding_audit[fiscal_year_start] )
			RETURN
			    CALCULATE (
			        [Total Dollars],
			        REMOVEFILTERS (
			            mart_funding_audit[fiscal_year],
			            mart_funding_audit[fiscal_year_start]
			        ),
			        mart_funding_audit[fiscal_year_start] = CurrentYear - 1
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 11c58555-5ea6-4ae8-b1da-f12871a7bf81

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'YoY Change $' =
			
			VAR Prev = [Dollars Previous Year]
			RETURN
			    IF (
			        HASONEVALUE ( mart_funding_audit[fiscal_year] ) && NOT ISBLANK ( Prev ),
			        [Total Dollars] - Prev
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ff680a2b-4047-449c-934d-161e89813dc9

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'YoY Change %' =
			
			VAR Prev = [Dollars Previous Year]
			RETURN
			    IF (
			        HASONEVALUE ( mart_funding_audit[fiscal_year] ) && NOT ISBLANK ( Prev ),
			        DIVIDE ( [Total Dollars] - Prev, Prev )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9681b933-a529-46fa-9583-7826765d0fef

	column fiscal_year
