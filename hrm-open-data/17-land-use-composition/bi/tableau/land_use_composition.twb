      <column caption='Community Area' datatype='real' name='[Calculation_1052539344011264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [community] : SUM([area]) }' />
      </column>
      <column caption='Class Share of Community' datatype='real' default-format='p0.00%' name='[Calculation_1052539344125953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([area]) / MIN([Calculation_1052539344011264])' />
      </column>
      <column caption='Largest Class Area' datatype='real' name='[Calculation_1052539346530306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [community] : MAX({ FIXED [community], [zone_class] : SUM([area]) }) }' />
      </column>
      <column caption='Mix Index' datatype='real' default-format='p0.00%' name='[Calculation_1052539346898948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ([Calculation_1052539346530306] / [Calculation_1052539344011264])' />
      </column>
      <column caption='Dominant Class Share' datatype='real' default-format='p0.00%' name='[Calculation_1052539353268229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ABS(SUM([area]) - MIN([Calculation_1052539346530306])) &lt; 0.0001&#13;&#10;THEN SUM([area]) / MIN([Calculation_1052539344011264])&#13;&#10;END' />
      </column>
